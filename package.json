{
  "name": "webscaly",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Local WebGPU video enhancement for Chrome",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/playwright.mjs",
    "test:gpu": "node scripts/gpu-check.mjs",
    "package": "node scripts/package.mjs",
    "store:assets": "node scripts/store-capture.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "prepare:publication": "node scripts/prepare-publication.mjs",
    "check": "npm run test && npm run build && npm run test:browser",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tabler/icons-react": "3.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.30",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "^0.1.65",
    "dashjs": "^5.2.1",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3",
    "plyr": "^3.8.5",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "video.js": "^8.24.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "plyr": false
  }
}
