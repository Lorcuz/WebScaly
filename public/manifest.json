{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.0",
  "minimum_chrome_version": "121",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebScaly"
  },
  "commands": {
    "toggle-enhancement": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_toggle_enhancement__"
    },
    "toggle-compare": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_toggle_compare__"
    },
    "cycle-engine": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_cycle_engine__"
    },
    "snapshot": {
      "description": "__MSG_snapshot__"
    },
    "toggle-pause": {
      "description": "__MSG_toggle_pause__"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui-frame.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "default_locale": "en"
}
