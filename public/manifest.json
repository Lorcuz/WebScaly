{
  "manifest_version": 3,
  "name": "WebScaly",
  "version": "0.4.0",
  "minimum_chrome_version": "121",
  "description": "Local video enhancement with WebGPU and WebGL on websites you approve.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebScaly"
  },
  "commands": {
    "toggle-enhancement": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Turn enhancement on or off for the video in this tab"
    },
    "toggle-compare": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Show or hide the original/enhanced comparison"
    },
    "cycle-engine": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Switch to the next enhancement engine"
    },
    "snapshot": {
      "description": "Save the current enhanced frame as an image"
    },
    "toggle-pause": {
      "description": "Pause or resume WebScaly on every website"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui-frame.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
